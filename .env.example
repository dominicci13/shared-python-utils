# --- Alerting -------------------------------------------------------------
# Outlook account used by alert_utils.handle_crash to email crash reports.
ALERT_EMAIL=alerts@example.com
# Optional AI crash summary (crash_explainer). All have defaults; CRASH_AI=0 turns it off.
# CRASH_AI=1
# CRASH_AI_MODEL=gpt-5.5
# CRASH_AI_EFFORT=high
# CRASH_AI_TIMEOUT=120
# CRASH_AI_KB_DIR=C:\path\to\knowledge-base

# --- SellerCloud ----------------------------------------------------------
# Tenant base URLs resolved by accounts.py for Delta and Alpha instances.
SELLERCLOUD_DELTA_URL=https://your-tenant.delta.sellercloud.com
SELLERCLOUD_ALPHA_URL=https://your-tenant.alpha.sellercloud.com
